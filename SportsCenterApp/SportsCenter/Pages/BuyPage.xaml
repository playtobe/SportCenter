<UserControl x:Class="SportsCenter.BuyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportsCenter">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="Mua hoặc gia hạn gói" Style="{StaticResource PageTitle}"/>

            <!-- Nhân viên chọn member; Member đăng nhập thì ô này ẩn đi -->
            <StackPanel Name="panelMember" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Label Content="Đang thao tác cho member"/>
                <ComboBox Name="cbxMember" Width="320" SelectionChanged="cbxMember_SelectionChanged"/>
            </StackPanel>

            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <TextBlock Name="txtCurrent" TextWrapping="Wrap"/>
            </Border>

            <GroupBox Header="CHỌN GÓI">
                <StackPanel>
                    <DataGrid Name="dgPackages" SelectionChanged="dgPackages_SelectionChanged"/>
                    <local:PagerControl x:Name="pgPackages" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="THANH TOÁN (mô phỏng, chỉ ghi nhận vào hệ thống)">
                <StackPanel>
                    <TextBlock Name="txtPreview" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <Label Content="Phương thức"/>
                            <ComboBox Name="cbxMethod" Width="170"/>
                        </StackPanel>
                        <Button Name="btnConfirm" Content="Xác nhận đã thu tiền" VerticalAlignment="Bottom" Click="btnConfirm_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
