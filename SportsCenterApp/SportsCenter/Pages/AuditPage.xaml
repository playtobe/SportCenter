<UserControl x:Class="SportsCenter.AuditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportsCenter">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="Lịch sử hoạt động" Style="{StaticResource PageTitle}"/>

            <!--FILTER AREA-->
            <GroupBox Header="BỘ LỌC">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Từ khóa (chi tiết, mã lớp, mã hóa đơn)"/>
                        <TextBox Name="txtKeyword" Width="240"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Người dùng"/>
                        <ComboBox Name="cbxUser" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Hành động"/>
                        <ComboBox Name="cbxAction" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Từ ngày"/>
                        <DatePicker Name="dpFrom" Width="130"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Đến ngày"/>
                        <DatePicker Name="dpTo" Width="130"/>
                    </StackPanel>
                    <Button Content="Lọc" VerticalAlignment="Bottom" Margin="4,4,4,10" Click="btnFilter_Click"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="4,4,4,10" Click="btnClearFilter_Click"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="LỊCH SỬ">
                <StackPanel>
                    <DataGrid Name="dgAudit"/>
                    <local:PagerControl x:Name="pgAudit" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
