<UserControl x:Class="SportsCenter.PaymentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SportsCenter">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="Thanh toán và hóa đơn" Style="{StaticResource PageTitle}"/>

            <!--FILTER AREA-->
            <GroupBox Header="BỘ LỌC">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Mã hóa đơn hoặc tên member"/>
                        <TextBox Name="txtSearch" Width="230"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Trạng thái"/>
                        <ComboBox Name="cbxStatus" Width="130"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Từ ngày"/>
                        <DatePicker Name="dpFrom" Width="130"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <Label Content="Đến ngày"/>
                        <DatePicker Name="dpTo" Width="130"/>
                    </StackPanel>
                    <Button Content="Lọc" VerticalAlignment="Bottom" Margin="4,4,4,10" Click="btnFilter_Click"/>
                    <Button Content="Xóa lọc" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="4,4,4,10" Click="btnClearFilter_Click"/>
                </WrapPanel>
            </GroupBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="THANH TOÁN" Margin="0,0,8,0">
                    <StackPanel>
                        <DataGrid Name="dgPayments" SelectionChanged="dgPayments_SelectionChanged"/>
                        <local:PagerControl x:Name="pgPayments" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="HÓA ĐƠN">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14" Background="#F7FAF9">
                            <TextBlock Name="txtInvoice" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Name="btnExport" Content="Xuất hóa đơn" Style="{StaticResource SecondaryButton}" Click="btnExport_Click"/>
                            <Button Name="btnRefund" Content="Hoàn tiền" Style="{StaticResource DangerButton}" Click="btnRefund_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
