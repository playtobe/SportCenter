<Window x:Class="SportsCenter.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" FontSize="13">
    <!-- Hộp thoại nhỏ mở từ nút "Đổi mật khẩu" ở góc dưới menu (thay cho màn Cài đặt cũ) -->
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Đổi mật khẩu" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Name="txtInfo" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap"/>

        <Label Content="Mật khẩu hiện tại"/>
        <PasswordBox Name="txtOld"/>
        <TextBlock Name="errOld" Style="{StaticResource ErrText}"/>

        <Label Content="Mật khẩu mới (ít nhất 6 ký tự)" Margin="0,10,0,0"/>
        <PasswordBox Name="txtNew"/>
        <TextBlock Name="errNew" Style="{StaticResource ErrText}"/>

        <Label Content="Nhập lại mật khẩu mới" Margin="0,10,0,0"/>
        <PasswordBox Name="txtConfirm"/>
        <TextBlock Name="errConfirm" Style="{StaticResource ErrText}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Hủy" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="80"/>
            <Button Content="Đổi mật khẩu" IsDefault="True" MinWidth="110" Click="btnChange_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
