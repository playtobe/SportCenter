<Window x:Class="SportsCenter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sports Center - Đăng nhập" Height="480" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="13">
    <StackPanel Margin="40,30">
        <TextBlock Text="Sports Center" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Hệ thống quản lý trung tâm thể thao" Foreground="{StaticResource Muted}" Margin="0,2,0,22"/>

        <Label Content="Tên đăng nhập"/>
        <TextBox Name="txtUsername"/>

        <Label Content="Mật khẩu" Margin="0,10,0,0"/>
        <PasswordBox Name="txtPassword"/>

        <Button Name="btnLogin" Content="Đăng nhập" IsDefault="True" Margin="0,20,0,0" Padding="14,9" Click="btnLogin_Click"/>
        <Button Name="btnRegister" Content="Đăng ký" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0" Padding="14,9" Click="btnRegister_Click"/>

        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,0"
                   Text="Tài khoản mẫu: manager1, reception1, coach1, member1 (mật khẩu chung 123456)"/>
    </StackPanel>
</Window>
